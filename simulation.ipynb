%matplotlib inline
import numpy as np
import matplotlib.pyplot as plt
from ipywidgets import interact, FloatSlider

# Setup Simulation Data
np.random.seed(42)
sampling_rate = 250
duration_dream = 10
duration_present = 2

time_dream = np.linspace(0, duration_dream, sampling_rate * duration_dream)
time_present = np.linspace(0, duration_present, sampling_rate * duration_present)

# Generate Base Strings
rem_wave = np.sin(2 * np.pi * 20 * time_dream) + np.sin(2 * np.pi * 40 * time_dream)
infinite_dream_string = rem_wave + np.random.normal(0, 1.5, len(time_dream))

waking_wave = np.sin(2 * np.pi * 18 * time_present)
present_string = waking_wave + np.random.normal(0, 0.5, len(time_present))

# Match at the 5-second mark
target_idx = 1250
match_length = 150
infinite_dream_string[target_idx : target_idx + match_length] = present_string[100 : 100 + match_length]

# Define the Rendering Loop Function
def scan_dream_database(scan_position):
    # Setup clean, spaced out layout
    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(9, 6))
    plt.subplots_adjust(hspace=0.4)
    
    # Target alignment point
    target_time = 5.0
    box_color = 'yellow'
    box_alpha = 0.4
    
    # Snapping/Locking Mechanism
    if abs(scan_position - target_time) < 0.15:
        scan_position = target_time
        box_color = 'red'
        box_alpha = 0.6

    # Plot Upper Graph (REM Dream Database)
    ax1.plot(time_dream, infinite_dream_string, color='gray', alpha=0.6, label='Deep Dream Memory')
    ax1.axvspan(scan_position, scan_position + 0.6, color=box_color, alpha=box_alpha, label='Scanning Mind...')
    ax1.set_title("Deep Neural Database (REM Sleep Memory String)")
    ax1.set_ylabel("Amplitude (µV)")
    ax1.grid(True, alpha=0.3)
    ax1.legend(loc='upper right')

    # Plot Lower Graph (Present Sensory Query)
    ax2.plot(time_present, present_string, color='blue', label='Present Reality String')
    ax2.set_title("Present Waking Processing (Shorter Reality String)")
    ax2.set_xlabel("Time (Seconds)")
    ax2.set_ylabel("Amplitude (µV)")
    ax2.grid(True, alpha=0.3)
    
    plt.show()

# Deploy Web Slider
interact(scan_dream_database, scan_position=FloatSlider(
    value=1.0, 
    min=0.0, 
    max=9.4, 
    step=0.05, 
    description='Scan Timeline:',
    continuous_update=False 
))
